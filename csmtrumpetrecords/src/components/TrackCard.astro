---
import type { Track } from '../types';
import { Download, Play, Pause } from 'lucide-astro';

interface Props { track: Track & { mov: string }; work: string; }
const { track, work } = Astro.props;
// "1º Movement" -> "1.er movimiento"
const name = track.mov
  ? track.mov.replace(/(\d+)\s*º\s*Movement/i, (_, n) => `${n}.${['1', '3'].includes(n) ? 'er' : 'º'} movimiento`)
  : 'Grabación completa';
---

<li class="mov" data-label={`${work}, ${name}`}>
  <audio src={track.audio_url} preload="metadata"></audio>
  <button type="button" class="play" aria-label={`Reproducir ${work}, ${name}`}>
    <span class="i-play"><Play size={16} class="fill-current" /></span>
    <span class="i-pause" hidden><Pause size={16} class="fill-current" /></span>
  </button>
  <div><span class="mov-name">{name}</span><span class="dur">0:00</span></div>
  <a class="dl" href={`/api/download/${track.id}`} aria-label={`Descargar ${work}, ${name}`}><Download size={15} />Descargar</a>
  <div class="ctl">
    <input type="range" class="bar" aria-label="Posición de reproducción" value="0" min="0" max="100" step="0.1" />
    <div class="ctl-row">
      <span class="cur">0:00</span>
      <div class="chips">
        <button type="button" class="chip speed" aria-label="Cambiar velocidad de reproducción">1×</button>
        <button type="button" class="chip loop" aria-pressed="false" title="Marca el inicio (A) y el final (B) de un pasaje para repetirlo">Bucle A-B</button>
      </div>
      <span class="total">0:00</span>
    </div>
  </div>
</li>

<script>
  const SPEEDS = [1, 0.9, 0.75, 0.5];
  const fmt = (s: number) => (isNaN(s) ? '0:00' : `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`);

  document.querySelectorAll<HTMLElement>('.mov').forEach((row) => {
    const $ = <T extends HTMLElement>(sel: string) => row.querySelector(sel) as T;
    const audio = $<HTMLAudioElement>('audio');
    const playBtn = $<HTMLButtonElement>('.play');
    const bar = $<HTMLInputElement>('.bar');
    const speedBtn = $<HTMLButtonElement>('.speed');
    const loopBtn = $<HTMLButtonElement>('.loop');
    const label = row.dataset.label ?? '';
    let speedIdx = 0;
    let a: number | null = null;
    let b: number | null = null;

    const setPlaying = (on: boolean) => {
      $('.i-play').hidden = on;
      $('.i-pause').hidden = !on;
      playBtn.setAttribute('aria-label', `${on ? 'Pausar' : 'Reproducir'} ${label}`);
    };

    audio.preservesPitch = true; // más lento sin bajar el tono
    audio.addEventListener('loadedmetadata', () => {
      $('.total').textContent = fmt(audio.duration);
      $('.dur').textContent = fmt(audio.duration);
    });
    audio.addEventListener('play', () => setPlaying(true));
    audio.addEventListener('pause', () => setPlaying(false));
    audio.addEventListener('ended', () => {
      bar.value = '0';
      $('.cur').textContent = '0:00';
      setPlaying(false);
    });
    playBtn.addEventListener('click', () => {
      if (!audio.paused) return audio.pause();
      document.querySelectorAll('audio').forEach((o) => o !== audio && o.pause());
      audio.play();
    });
    audio.addEventListener('timeupdate', () => {
      if (a !== null && b !== null && audio.currentTime >= b) audio.currentTime = a;
      if (audio.duration) {
        bar.value = String((audio.currentTime / audio.duration) * 100);
        $('.cur').textContent = fmt(audio.currentTime);
      }
    });
    bar.addEventListener('input', () => {
      if (audio.duration) audio.currentTime = (parseFloat(bar.value) / 100) * audio.duration;
    });
    speedBtn.addEventListener('click', () => {
      speedIdx = (speedIdx + 1) % SPEEDS.length;
      audio.playbackRate = SPEEDS[speedIdx];
      speedBtn.textContent = `${SPEEDS[speedIdx]}×`;
    });
    // 1.er clic: marca A · 2.º: marca B y repite · 3.º: quita el bucle
    loopBtn.addEventListener('click', () => {
      if (a === null) {
        a = audio.currentTime;
        loopBtn.textContent = `A ${fmt(a)}, marca B`;
        loopBtn.setAttribute('aria-pressed', 'true');
      } else if (b === null) {
        if (audio.currentTime <= a + 0.5) return;
        b = audio.currentTime;
        loopBtn.textContent = `${fmt(a)} a ${fmt(b)}, quitar`;
      } else {
        a = b = null;
        loopBtn.textContent = 'Bucle A-B';
        loopBtn.setAttribute('aria-pressed', 'false');
      }
    });
  });
</script>
