---
import '../styles/global.css';
const ADMIN_PASSWORD = import.meta.env.ADMIN_PASSWORD;
let isAuthenticated = Astro.cookies.has('admin_session');
let loginError = false;

if (Astro.request.method === 'POST' && !isAuthenticated) {
  const data = await Astro.request.formData();
  const password = data.get('password');
  
  if (password === ADMIN_PASSWORD) {
    Astro.cookies.set('admin_session', 'true', { path: '/', maxAge: 60 * 60 * 24 * 7 });
    isAuthenticated = true;
  } else {
    loginError = true;
  }
}
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Admin Masivo | CSMTrumpetRecords</title>
  </head>
  <body class="bg-neutral-950 text-white min-h-screen p-4 md:p-8">
    
    {!isAuthenticated ? (
      <div class="w-full max-w-sm mx-auto bg-neutral-900 p-8 rounded-xl border border-neutral-800 shadow-xl mt-10">
        <h1 class="text-xl font-bold mb-2">Acceso Restringido</h1>
        <p class="text-sm text-neutral-400 mb-6">Introduce la contraseña para subir archivos.</p>
        
        <form method="POST" class="flex flex-col gap-4">
          <input type="password" name="password" placeholder="Contraseña" required class="w-full bg-neutral-950 border border-neutral-800 rounded-lg p-3 text-sm focus:border-indigo-500 focus:outline-none" />
          {loginError && <p class="text-red-400 text-xs">Contraseña incorrecta</p>}
          <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-3 rounded-lg transition mt-2">
            Entrar
          </button>
        </form>
      </div>
    ) : (
      <div class="w-full max-w-2xl mx-auto bg-neutral-900 p-6 md:p-8 rounded-xl border border-neutral-800 shadow-xl">
        <div class="flex justify-between items-center mb-6">
          <div>
            <h1 class="text-2xl font-bold">Subida Masiva de Audios</h1>
            <p class="text-sm text-neutral-400 mt-1">Sube varios MP3 a la vez. El nombre del archivo será el título.</p>
          </div>
          <span class="text-xs bg-indigo-900/50 text-indigo-300 px-2 py-1 rounded border border-indigo-800">Sesión Activa</span>
        </div>
        
        <form id="bulk-upload-form" class="flex flex-col gap-5">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm text-neutral-400 mb-1">Intérprete para este lote</label>
              <input type="text" id="batch-artist" required placeholder="Ej: Aula de Trompeta" class="w-full bg-neutral-950 border border-neutral-800 rounded-lg p-2.5 text-sm focus:border-indigo-500 focus:outline-none" />
            </div>

            <div>
              <label class="block text-sm text-neutral-400 mb-1">Categoría para este lote</label>
              <select id="batch-category" class="w-full bg-neutral-950 border border-neutral-800 rounded-lg p-2.5 text-sm focus:border-indigo-500 focus:outline-none">
                <option value="Conciertos">Conciertos</option>
                <option value="Estudios">Estudios</option>
                <option value="Pasajes Orquestales">Pasajes Orquestales</option>
                <option value="Cámara">Cámara</option>
              </select>
            </div>
          </div>

          <div class="border-2 border-dashed border-neutral-700 hover:border-indigo-500 transition-colors rounded-xl p-8 text-center bg-neutral-950/50 relative">
            <input type="file" id="file-input" accept="audio/mpeg, audio/mp3" multiple required class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
            <div class="pointer-events-none">
              <p class="text-indigo-400 font-semibold mb-1">Haz clic para seleccionar o arrastra tus MP3 aquí</p>
              <p class="text-xs text-neutral-500">Puedes seleccionar 10, 20 o los archivos que quieras.</p>
            </div>
          </div>

          <button type="submit" id="submit-btn" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-3 rounded-lg transition disabled:opacity-50 disabled:cursor-not-allowed hidden">
            Comenzar subida de <span id="file-count">0</span> archivos
          </button>
        </form>

        <div id="upload-queue" class="mt-6 space-y-2 hidden">
          <h3 class="text-sm font-semibold text-neutral-300 border-b border-neutral-800 pb-2 mb-3">Progreso de subida</h3>
          <div id="queue-list" class="flex flex-col gap-2 max-h-96 overflow-y-auto pr-2"></div>
        </div>
      </div>
    )}

    <script>
      const form = document.getElementById('bulk-upload-form') as HTMLFormElement;
      const fileInput = document.getElementById('file-input') as HTMLInputElement;
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
      const fileCountSpan = document.getElementById('file-count') as HTMLSpanElement;
      const uploadQueue = document.getElementById('upload-queue') as HTMLDivElement;
      const queueList = document.getElementById('queue-list') as HTMLDivElement;
      const batchArtist = document.getElementById('batch-artist') as HTMLInputElement;
      const batchCategory = document.getElementById('batch-category') as HTMLSelectElement;

      if (fileInput) {
        // Mostrar el botón cuando se seleccionan archivos
        fileInput.addEventListener('change', () => {
          const files = fileInput.files;
          if (files && files.length > 0) {
            fileCountSpan.textContent = files.length.toString();
            submitBtn.classList.remove('hidden');
            
            // Previsualizar la lista
            queueList.innerHTML = '';
            uploadQueue.classList.remove('hidden');
            
            Array.from(files).forEach((file, index) => {
              // Limpiar el nombre del archivo para usarlo de título
              const autoTitle = file.name.replace(/\.[^/.]+$/, ""); 
              
              const item = document.createElement('div');
              item.id = `queue-item-${index}`;
              item.className = 'flex justify-between items-center bg-neutral-950 p-3 rounded-lg border border-neutral-800 text-sm';
              item.innerHTML = `
                <span class="truncate pr-4 flex-1 text-neutral-300">${autoTitle}</span>
                <span class="status text-xs font-mono text-neutral-500 bg-neutral-900 px-2 py-1 rounded">En espera...</span>
              `;
              queueList.appendChild(item);
            });
          } else {
            submitBtn.classList.add('hidden');
            uploadQueue.classList.add('hidden');
          }
        });

        // Procesar la subida en lote
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const files = fileInput.files;
          if (!files || files.length === 0) return;

          const artist = batchArtist.value;
          const category = batchCategory.value;

          // Bloquear UI
          submitBtn.disabled = true;
          fileInput.disabled = true;
          batchArtist.disabled = true;
          batchCategory.disabled = true;

          let successCount = 0;

          // Subir archivos uno por uno para no saturar el servidor ni la red
          for (let i = 0; i < files.length; i++) {
            const file = files[i];
            const autoTitle = file.name.replace(/\.[^/.]+$/, "");
            const statusBadge = document.querySelector(`#queue-item-${i} .status`) as HTMLSpanElement;
            const queueItem = document.getElementById(`queue-item-${i}`) as HTMLDivElement;

            statusBadge.textContent = 'Subiendo...';
            statusBadge.className = 'status text-xs font-mono text-indigo-400 bg-indigo-900/30 border border-indigo-800/50 px-2 py-1 rounded animate-pulse';

            const formData = new FormData();
            formData.append('file', file);
            formData.append('title', autoTitle); // Auto-nombramiento
            formData.append('artist', artist);
            formData.append('category', category);

            try {
              const response = await fetch('/api/upload', {
                method: 'POST',
                body: formData,
              });

              if (response.ok) {
                statusBadge.textContent = '¡Completado!';
                statusBadge.className = 'status text-xs font-mono text-green-400 bg-green-900/30 border border-green-800/50 px-2 py-1 rounded';
                queueItem.classList.add('border-green-900/50');
                successCount++;
              } else {
                const result = await response.json();
                throw new Error(result.error || 'Error de servidor');
              }
            } catch (error: any) {
              statusBadge.textContent = 'Error';
              statusBadge.className = 'status text-xs font-mono text-red-400 bg-red-900/30 border border-red-800/50 px-2 py-1 rounded';
              statusBadge.title = error.message; // Mostrar error al pasar el ratón
            }
          }

          submitBtn.textContent = `Proceso finalizado (${successCount}/${files.length})`;
          submitBtn.classList.replace('bg-indigo-600', 'bg-neutral-800');
          submitBtn.classList.replace('hover:bg-indigo-500', 'hover:bg-neutral-700');
        });
      }
    </script>
  </body>
</html>