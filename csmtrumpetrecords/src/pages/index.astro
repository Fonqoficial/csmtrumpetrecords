---
import Layout from '../layouts/Layout.astro';
import TrackCard from '../components/TrackCard.astro';
import { supabase } from '../lib/supabase';
import type { Track } from '../types';
import { FileText } from 'lucide-astro';

const { data, error } = await supabase.from('tracks').select('*');
if (error) console.error('Error al obtener los audios:', error.message);

// "Concerto nº 1 - 1º Movement" -> obra + movimiento
const split = (t: string) => {
  const m = t.match(/^(.*?)\s+[-–—]\s+(.+)$/);
  return m ? { work: m[1].trim(), mov: m[2].trim() } : { work: t.trim(), mov: '' };
};
const norm = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

const groups = new Map<string, { work: string; artist: string; tracks: (Track & { mov: string })[] }>();
for (const t of (data ?? []) as Track[]) {
  const { work, mov } = split(t.title);
  const key = `${t.artist}|${work}`;
  if (!groups.has(key)) groups.set(key, { work, artist: t.artist, tracks: [] });
  groups.get(key)!.tracks.push({ ...t, mov });
}
const works = [...groups.values()]
  .sort((a, b) => a.artist.localeCompare(b.artist, 'es') || a.work.localeCompare(b.work, 'es', { numeric: true }))
  .map((g) => ({ ...g, tracks: g.tracks.sort((a, b) => a.mov.localeCompare(b.mov, 'es', { numeric: true })) }));
const cats = [...new Set((data ?? []).map((t: Track) => t.category).filter(Boolean))] as string[];
---

<Layout
  title="CSMTrumpetRecords · Aula de Trompeta del CSM de Sevilla"
  description="Acompañamientos y grabaciones en mp3 del aula de Trompeta del Conservatorio Superior de Música de Sevilla, con control de velocidad y bucle."
>
  <div class="wrap">
    <header class="masthead">
      <h1>CSMTrumpetRecords</h1>
      <p>Grabaciones del aula de Trompeta del Conservatorio Superior de Música de Sevilla.</p>
    </header>

    <div class="tools">
      <input type="search" id="q" placeholder="Buscar por obra o compositor" aria-label="Buscar por obra o compositor" />
      {cats.length > 1 && (
        <div class="cats" role="group" aria-label="Filtrar por categoría">
          <button type="button" class="cat" data-cat="" aria-pressed="true">Todas</button>
          {cats.map((c) => <button type="button" class="cat" data-cat={c} aria-pressed="false">{c}</button>)}
        </div>
      )}
    </div>

    <main>
      {error && <p class="empty">No se han podido cargar las grabaciones. Recarga la página en unos segundos.</p>}
      {!error && works.length === 0 && <p class="empty">Aún no hay grabaciones. Vuelve pronto.</p>}

      {works.map((w) => {
        const score = w.tracks.find((t) => t.score_url)?.score_url;
        return (
          <section class="work" data-search={norm(`${w.work} ${w.artist}`)} data-cats={w.tracks.map((t) => t.category).join('|')}>
            <div class="work-head">
              <div>
                <h2>{w.work}</h2>
                <p class="composer">{w.artist}</p>
              </div>
              {score && <a class="score" href={score} target="_blank" rel="noopener noreferrer"><FileText size={15} />Partitura (PDF)</a>}
            </div>
            <ol class="movs">
              {w.tracks.map((t) => <TrackCard track={t} work={w.work} />)}
            </ol>
          </section>
        );
      })}
      <p id="none" class="empty" hidden>Ninguna grabación coincide con la búsqueda.</p>
    </main>

    <footer class="site-foot">Material de estudio del aula de Trompeta. Grabaciones de uso interno del alumnado.</footer>
  </div>

  <script>
    const norm = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    const q = document.getElementById('q') as HTMLInputElement;
    const none = document.getElementById('none')!;
    const catBtns = document.querySelectorAll<HTMLButtonElement>('.cat');
    let cat = '';

    const apply = () => {
      const term = norm(q.value.trim());
      let shown = 0;
      document.querySelectorAll<HTMLElement>('.work').forEach((w) => {
        const ok = (w.dataset.search ?? '').includes(term) && (!cat || (w.dataset.cats ?? '').split('|').includes(cat));
        w.hidden = !ok;
        if (ok) shown++;
      });
      none.hidden = shown > 0;
    };
    q.addEventListener('input', apply);
    catBtns.forEach((b) =>
      b.addEventListener('click', () => {
        cat = b.dataset.cat ?? '';
        catBtns.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
        apply();
      }),
    );
  </script>
</Layout>
